<resources>
    <!-- Base theme; Compose (Theme.kt) drives all actual colors/typography.
         This XML theme just needs to exist for the manifest + splash. -->
    <style name="Theme.MobileStoreInventory" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0B1F3A</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <!-- Splash screen theme (androidx.core.splashscreen). Applied to
         MainActivity only for the brief moment before setContent() runs. -->
    <style name="Theme.MobileStoreInventory.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1F3A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MobileStoreInventory</item>
    </style>
</resources>
